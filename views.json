[
  {
    "name": "Nodes",
    "levels": ["site", "cluster", "host"],
    "leaf_label_template": "{host|short}",
    "filter": {"field": "production", "value": "YES", "exclude": true}
  },
  {
    "name": "Nodes (production)",
    "levels": ["site", "cluster", "host"],
    "leaf_label_template": "{host|short}",
    "filter": {"field": "production", "value": "YES", "exclude": false}
  },
  {
    "name": "vlans",
    "levels": ["site", "type", "vlan"],
    "leaf_label_template": "{type}/{vlan}"
  },
  {
    "name": "Subnets",
    "levels": ["site", "slash_16", "slash_17", "slash_18", "slash_19", "slash_20", "slash_21", "slash_22"],
    "leaf_label_template": "{subnet_address}",
    "sort_by_label": true
  },
  {
    "name": "Disks",
    "levels": ["site", "cluster", "host", "type", "disk"],
    "leaf_label_template": "{disk}"
  }
]
